{
  "hosting": {
    "public": "site/build/dist/js/productionExecutable/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/hiragame",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/topics",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/topics/",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/lesson",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/lesson/",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/review",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/review/",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/settings",
        "destination": "/hiragame/index.html"
      },
      {
        "source": "/hiragame/settings/",
        "destination": "/hiragame/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/hiragame/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/hiragame/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
