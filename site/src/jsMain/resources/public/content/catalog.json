  "topics": [
    {
      "id": "kana-foundations",
      "title": "Hiragana foundations",
      "description": "Basic, voiced, semi-voiced and contracted hiragana, word-spelling contrasts, and a two-sign romaji beginner option."
    },
    {
      "id": "katakana-foundations",
      "title": "Katakana foundations",
      "description": "Basic, voiced, semi-voiced and contracted katakana, plus long-mark and small-kana word-spelling contrasts, in bounded recognition and typed-kana sets."
    },
    {
      "id": "foundational-vocabulary",
      "title": "Foundational vocabulary",
      "description": "Daily-life and engineering-workplace words in two independent six-item kana-reading sets."
    },
    {
      "id": "workplace-clarification",
      "title": "Workplace clarification",
      "description": "Ask for missing task details and confirm your interpretation with a teammate; a separate short lesson checks a meeting time."
    },
    {
      "id": "workplace-introductions",
      "title": "Workplace introductions",
      "description": "Introduce your engineering role and relevant work when meeting a teammate."
    },
    {
      "id": "workplace-updates",
      "title": "Workplace updates",
      "description": "Give a concise team update, explain a factual blocker, and agree on the next step."
    },
    {
      "id": "workplace-bugs",
      "title": "Bug reports",
      "description": "Describe expected and actual test behavior and give reproducible steps without guessing a cause."
    },
    {
      "id": "workplace-reviews",
      "title": "Code reviews",
      "description": "Request a focused code review and respond constructively to a teammate's suggestion."
    },
    {
      "id": "workplace-requirements-clarification",
      "title": "Requirements clarification",
      "description": "Ask who needs a feature and which part matters first."
    },
    {
      "id": "workplace-estimates-deadlines",
      "title": "Estimates and deadlines",
      "description": "Give a provisional estimate and clarify its scope before promising a date."
    },
    {
      "id": "workplace-incident-report",
      "title": "Incident reports",
      "description": "Report an observed problem and separate known impact from what is still being checked."
    },
    {
      "id": "workplace-design-tradeoffs",
      "title": "Design trade-offs",
      "description": "Describe one benefit and one cost, then ask which priority matters."
    },
    {
      "id": "workplace-technical-interview",
      "title": "Technical interviews",
      "description": "Describe a real project and your contribution without inventing experience."
    },
    {
      "id": "life-transport",
      "title": "Transport questions",
      "description": "Confirm a destination and platform in an illustrative station exchange."
    },
    {
      "id": "life-housing-viewing",
      "title": "Housing enquiries",
      "description": "Ask about viewing a room and confirm a proposed time."
    },
    {
      "id": "life-appointment-change",
      "title": "Changing an appointment",
      "description": "Request an appointment change and check availability."
    },
    {
      "id": "life-administration-questions",
      "title": "Administration questions",
      "description": "Ask staff what applies to a procedure and clarify how to fill a form."
    }
  ],
